---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="Page not found"
	description="The page you were looking for doesn't exist. Head back to the portfolio, services, or contact page."
	noindex
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Error 404</span>
			<h1>
				This page
				<br />
				doesn’t exist.
			</h1>
			<p class="lead">
				The link may be outdated or mistyped. Try one of these instead.
			</p>
			<div class="actions">
				<a class="button" href="/">Go home</a>
				<a class="button secondary" href="/portfolio">View portfolio</a>
				<a class="button secondary" href="/services">Services</a>
				<a class="button secondary" href="/contact">Contact</a>
			</div>
		</div>
	</section>
</SiteLayout>
