---
import EngagementFAQ from '../components/EngagementFAQ.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectInvitation from '../components/ProjectInvitation.astro';
import { engagementFaq } from '../data/faq';
const services = [
	{
		name: 'Complete software solution',
		description:
			'Connected software with technical ownership across requirements, architecture, mobile apps, web experiences, backend systems, administration tools, integrations, testing, deployment, and handover.',
	},
	{
		name: 'Focused app or system development',
		description:
			'Flutter and native Android apps, websites and administration interfaces, backend APIs and business logic, and third-party integrations.',
	},
	{
		name: 'Existing software improvement',
		description:
			'New features and integrations, performance and architecture improvements, maintenance and release support, and technical consulting for existing software.',
	},
];
---

<SiteLayout
	title="Mobile, web & backend development services"
	description="Mobile, web, admin panel, backend, and cloud deployment delivered end to end. Focused development, software improvements, and technical consulting."
	breadcrumbs={[{ name: 'Services', path: '/services' }]}
	schema={[
		{
			'@type': 'ProfessionalService',
			'@id': 'https://www.devminhaj.me/services#service',
			name: 'Minhaj Nadeem — Software development services',
			url: 'https://www.devminhaj.me/services',
			founder: { '@id': 'https://www.devminhaj.me/#person' },
			areaServed: 'Worldwide',
			serviceType: 'Software development',
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Software development services',
				itemListElement: services.map((s) => ({
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: s.name, description: s.description },
				})),
			},
		},
		{
			'@type': 'FAQPage',
			mainEntity: engagementFaq.map((f) => ({
				'@type': 'Question',
				name: f.question,
				acceptedAnswer: { '@type': 'Answer', text: f.answer },
			})),
		},
	]}
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Software development services</span>
			<h1>
				Complete technical delivery.
				<br />
				From requirements to deployment.
			</h1>
			<p class="lead">
				You bring the business requirements. I handle the engineering: architecture, implementation,
				integrations, testing, and deployment. Flutter and Android app development, websites and
				admin portals, backend APIs, and Google Cloud deployment, delivered remotely for clients
				worldwide.
			</p>
		</div>
	</section>
	<section class="section">
		<div class="container grid">
			<article class="card">
				<span class="number">01 / COMPLETE SOLUTION</span>
				<h2>Build a complete software solution</h2>
				<p>
					Build the connected software your business needs, with technical ownership across its
					applications and supporting systems.
				</p>
				<ul class="list">
					<li>Technical requirements and architecture</li>
					<li>Mobile apps and web experiences</li>
					<li>Backend systems and administration tools</li>
					<li>Integrations, testing, deployment, and handover</li>
				</ul>
				<p class="example">
					Example: <a href="/portfolio/sdrive">SDrive ride-hailing platform case study</a>
				</p>
				<a class="text-link" href="/contact?service=launch">
					Discuss your software solution →
				</a>
			</article>
			<article class="card">
				<span class="number">02 / FOCUSED DEVELOPMENT</span>
				<h2>Develop an app or system</h2>
				<p>
					A focused development engagement for a specific application or component, connected to
					your existing systems.
				</p>
				<ul class="list">
					<li>Flutter and native Android apps</li>
					<li>Websites and administration interfaces</li>
					<li>Backend APIs and business logic</li>
					<li>Third-party and existing-system integrations</li>
				</ul>
				<p class="example">
					Example: <a href="/portfolio/twidlee">Twidlee Android app case study</a>
				</p>
				<a class="text-link" href="/contact?service=platform">
					Discuss your app or system →
				</a>
			</article>
			<article class="card">
				<span class="number">03 / EXISTING SOFTWARE</span>
				<h2>Improve existing software</h2>
				<p>
					Extend and maintain the software your business already uses, with hands-on development and
					technical advice.
				</p>
				<ul class="list">
					<li>New features and integrations</li>
					<li>Performance and architecture improvements</li>
					<li>Maintenance and release support</li>
					<li>Technical feasibility and implementation consulting</li>
				</ul>
				<p class="example">
					Example: <a href="/portfolio">more case studies in the portfolio</a>
				</p>
				<a class="text-link" href="/contact?service=improve">
					Discuss your existing software →
				</a>
			</article>
		</div>
	</section>
	<section class="section dark">
		<div class="container split">
			<div>
				<span class="eyebrow">For complex technical work</span>
				<h2>
					Define the implementation.
					<br />
					Then build.
				</h2>
				<p class="lead">
					Technical scoping turns your requirements into an implementation plan. We review the
					systems, dependencies, and integration constraints before estimating the work.
				</p>
			</div>
			<div>
				<h3>Technical scoping deliverables</h3>
				<p class="muted">
					A defined implementation scope, recommended architecture, integration dependencies,
					delivery milestones, and an estimate. The scope and any fee for this work are agreed
					before it begins.
				</p>
				<a class="button" href="/contact?service=scoping">
					Discuss technical scoping ↗
				</a>
			</div>
		</div>
	</section>
	<EngagementFAQ />
	<ProjectInvitation />
</SiteLayout>
<style>
	.card h2 {
		font-size: 1.9rem;
	}
	.card {
		display: flex;
		flex-direction: column;
	}
	.example {
		margin: 0 0 16px;
		font-size: 0.95rem;
	}
	.example a {
		text-decoration: underline;
	}
	.card .text-link {
		margin-top: auto;
		align-self: flex-start;
	}
</style>
