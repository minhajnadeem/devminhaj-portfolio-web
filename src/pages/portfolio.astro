---
import SiteLayout from '../layouts/SiteLayout.astro';
import {portfolioProjects,getProjectImages} from '../data/portfolio';
import SDriveVisual from '../components/SDriveVisual.astro';
import ProjectInvitation from '../components/ProjectInvitation.astro';
const groups:Record<string,string>={sdrive:'services',twidlee:'services',maxximus:'services',bbm:'services','pioneer-labs':'services','hifz-diary':'operations','sf-gas-works':'operations',terragrow:'operations',skyview:'operations','speedfame-tv':'operations'};
const categories=[{id:'all',label:'All work'},{id:'services',label:'Marketplaces & services'},{id:'operations',label:'Business operations'},{id:'consumer',label:'Consumer products'}];
---
<SiteLayout title="Apps & business platforms — Work" description="Explore SDrive, Badminton Famly+, Twidlee, Hifz Diary, and more. Case studies explain the business need, Minhaj’s delivery scope, and the software delivered."><section class="page-hero"><div class="container"><span class="eyebrow">Selected experience</span><h1>Real products.<br/>Different business problems.</h1><p class="lead">From complete platform delivery to focused app development. Each project explains what the business needed and the work I owned.</p></div></section><section class="section"><div class="container"><div class="featured-work split"><SDriveVisual /><div><span class="eyebrow">Flagship / Complete platform</span><h2>SDrive</h2><p class="lead">A ride-hailing platform connecting riders, drivers, and business operations.</p><p><strong>My responsibility:</strong> Sole developer of the apps, marketing website, administration portal, backend, and cloud deployment.</p><a class="button" href="/portfolio/sdrive">Explore SDrive →</a></div></div><div class="filters" role="group" aria-label="Filter work by business context">{categories.map((c,i)=><button class="filter" data-category={c.id} aria-pressed={i===0?'true':'false'}>{c.label}</button>)}</div><p id="work-count" class="muted" aria-live="polite">{portfolioProjects.length-1} projects</p><div class="work-grid">{portfolioProjects.filter(p=>p.id!=='sdrive').map(p=><article class="project-card" data-work-category={groups[p.id]??'consumer'}><a href={`/portfolio/${p.id}`}><div class="project-image">{getProjectImages(p)[0]?<img src={getProjectImages(p)[0]} alt={`${p.name} product preview`} loading="lazy"/>:<span>{p.name}</span>}</div><h3>{p.name} ↗</h3></a><p>{p.pitch}</p><p><strong>My responsibility:</strong> {p.roleSnippet}</p><span class="tag">{p.type==='native'?'Native Android':'Flutter'}</span></article>)}</div></div></section><ProjectInvitation /></SiteLayout>
<script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-category]');const cards=document.querySelectorAll<HTMLElement>('[data-work-category]');buttons.forEach(button=>button.addEventListener('click',()=>{const category=button.dataset.category;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;cards.forEach(card=>{card.hidden=category!=='all'&&card.dataset.workCategory!==category;if(!card.hidden)count++});const label=document.getElementById('work-count');if(label)label.textContent=`${count} projects`;}));</script><style>.featured-work{margin-bottom:80px}</style>
