---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ProjectInvitation from '../components/ProjectInvitation.astro';
import { skillCategories } from '../data/skills';
---

<SiteLayout
	title="About Minhaj — Full Stack Product Engineer"
	description="Meet Minhaj Nadeem, a Full Stack Product Engineer with eight-plus years in Android and Flutter and experience delivering connected platforms."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">About Minhaj</span>
			<h1>
				A mobile foundation.
				<br />A whole-product perspective.
			</h1>
			<p class="lead">
				Full Stack Product Engineer, with eight-plus years of hands-on mobile development and
				experience delivering connected software from requirements through deployment.
			</p>
		</div>
	</section>
	<section class="section">
		<div class="container split">
			<ProfilePhoto />
			<div>
				<h2>
					I care about how
					<br />
					the product works.
				</h2>
				<p>
					My journey began with native Android and Java, then expanded into Kotlin, modern Android
					architecture, and Flutter. That foundation taught me to build for performance,
					maintainability, and real users.
				</p>
				<p>
					I’ve worked with startups, international remote teams, and product companies across Dubai
					and Germany, collaborating with founders and leadership on technical decisions.
				</p>
				<p>
					SDrive represents the next step in that journey: independently delivering rider and driver
					apps alongside a marketing website, administration portal, backend, and deployment on
					Google Cloud.
				</p>
				<p>
					My focus is complete technical delivery: clarifying requirements, choosing architecture,
					implementing connected systems, testing, and preparing deployment and handover. I also
					provide technical consulting on feasibility, integrations, and implementation tradeoffs.
				</p>
				<a class="text-link" href="/portfolio/sdrive">
					Explore the SDrive delivery →
				</a>
			</div>
		</div>
	</section>
	<section class="section dark">
		<div class="container">
			<div class="section-heading">
				<span class="eyebrow">Delivery capabilities</span>
				<h2>
					The pieces that make
					<br />a product work together.
				</h2>
			</div>
			<div class="grid">
				<article>
					<h3>Customer applications</h3>
					<p class="muted">
						Flutter and native Android, built around customer and provider journeys.
					</p>
				</article>
				<article>
					<h3>Web and backend systems</h3>
					<p class="muted">
						Marketing websites, administration interfaces, APIs, data, authentication, and business
						logic.
					</p>
				</article>
				<article>
					<h3>Deployment and delivery</h3>
					<p class="muted">
						Requirements, milestones, testing, cloud deployment, releases, and maintenance.
					</p>
				</article>
			</div>
		</div>
	</section>
	<section class="section">
		<div class="container">
			<span class="eyebrow">Technical foundation</span>
			<h2>Depth behind the broader offer.</h2>
			<div class="grid">
				{skillCategories.map((c) => (
					<article class="card">
						<h3>{c.category}</h3>
						{c.items.map((i) => (
							<span class="tag">{i}</span>
						))}
					</article>
				))}
			</div>
			<div class="actions">
				<a class="button secondary" href="/files/Minhaj-Nadeem-Resume-12-2025.pdf" download>
					Download resume · December 2025 ↓
				</a>
			</div>
		</div>
	</section>
	<ProjectInvitation />
</SiteLayout>
