---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getProjectById, getProjectImages, portfolioProjects } from '../../data/portfolio';
import { standardCaseStudies } from '../../data/caseStudies';

export function getStaticPaths() {
	return portfolioProjects
		.filter((project) => project.caseStudyKind !== 'featured')
		.map((project) => ({ params: { id: project.id } }));
}

const project = getProjectById(Astro.params.id!);
if (!project) return Astro.redirect('/portfolio');
const story = standardCaseStudies[project.id];
if (!story) throw new Error(`Missing standard case study: ${project.id}`);
const imageUrls = getProjectImages(project);
const links = project.links ?? [];
const platform =
	project.id === 'speedfame-tv'
		? 'Android TV'
		: project.type === 'native'
			? 'Native Android'
			: 'Flutter';
const archive = ['bbm', 'beat-bully-trivia', 'whatsapp-sticker'].includes(project.id);
const internal = ['sf-gas-works', 'skyview'].includes(project.id);
const status = archive
	? 'Historical project · App delisted'
	: internal
		? 'Internal distribution'
		: 'Published project';
const related = portfolioProjects
	.filter(
		(p) =>
			p.id !== project.id &&
			p.caseStudyKind !== 'featured' &&
			standardCaseStudies[p.id]?.category === story.category
	)
	.slice(0, 2);

function screenshotCaption(index: number) {
	if (project!.id === 'hifz-diary') {
		return (
			[
				'Parent app · Dashboard and student progress',
				'Parent app · Leave requests and fee summary',
				'Owner app · Attendance, leave approvals, and progress',
				'Owner app · Management dashboard, fees, and teacher details',
				'Teacher app · Classes and student overview',
				'Teacher app · Recording attendance and progress',
			][index] ?? 'Hifz Diary product preview'
		);
	}
	return `${platform} application · Product preview ${index + 1}`;
}
---

<SiteLayout title={`${project.name} — Work`} description={project.pitch}>
	<section class="case-header">
		<div class="container">
			<a class="text-link" href="/portfolio">
				← All work
			</a>
			<p class="eyebrow case-category">{story.category} / Project overview</p>
			<h1>{project.name}</h1>
			<p class="lead">{project.pitch}</p>
			<dl class="case-facts">
				<div>
					<dt>My scope</dt>
					<dd>{story.scope}</dd>
				</div>
				<div>
					<dt>Platform</dt>
					<dd>{platform}</dd>
				</div>
				<div>
					<dt>Distribution</dt>
					<dd>{status}</dd>
				</div>
			</dl>
		</div>
	</section>

	<div class="container case-body">
		<div class="case-overview">
			<section aria-labelledby="business-heading">
				<h2 id="business-heading">The business need</h2>
				<p>{story.businessNeed}</p>
			</section>
			<section aria-labelledby="scope-heading">
				<h2 id="scope-heading">My responsibility</h2>
				<p>{story.responsibility}</p>
			</section>
		</div>

		<section class="case-section" aria-labelledby="solution-heading">
			<h2 id="solution-heading">What I delivered</h2>
			<p class="case-copy">{story.solution}</p>
			{project.keyFeatures?.length && (
				<ul class="capabilities">
					{project.keyFeatures.map((feature) => (
						<li>{feature}</li>
					))}
				</ul>
			)}
		</section>

		{imageUrls.length > 0 && (
			<section class="case-section" aria-labelledby="screenshots-heading">
				<h2 id="screenshots-heading">Product previews</h2>
				<p class="muted">Select a preview to view the full image.</p>
				<div class:list={['screenshot-grid', { 'single-preview': imageUrls.length === 1 }]}>
					{imageUrls.map((src, index) => (
						<figure>
							<button
								class="screenshot-trigger"
								type="button"
								data-src={src}
								data-caption={`${project.name} — ${screenshotCaption(index)}`}
								aria-label={`Expand ${project.name}: ${screenshotCaption(index)}`}
							>
								<img
									src={src}
									alt={`${project.name} — ${screenshotCaption(index)}`}
									loading="lazy"
									decoding="async"
								/>
								<span class="expand-label" aria-hidden="true">
									View full image ↗
								</span>
							</button>
							<figcaption>{screenshotCaption(index)}</figcaption>
						</figure>
					))}
				</div>
			</section>
		)}

		<section class="case-outcome" aria-labelledby="outcome-heading">
			<span class="eyebrow">Delivery outcome</span>
			<h2 id="outcome-heading">The result</h2>
			<p>{story.outcome}</p>
			{archive && (
				<p class="availability-note">
					The app has since been delisted. This page documents the work delivered during the
					engagement.
				</p>
			)}
			{internal && (
				<p class="availability-note">
					Built for internal use; there is no public app-store listing.
				</p>
			)}
		</section>

		<section class="case-section" aria-labelledby="tech-heading">
			<h2 id="tech-heading">Technology used</h2>
			<div class="case-tech">
				{project.tech.map((tech) => (
					<span class="tag">{tech}</span>
				))}
			</div>
		</section>

		{links.length > 0 && (
			<section class="case-section" aria-labelledby="links-heading">
				<h2 id="links-heading">Project links</h2>
				<div class="case-links">
					{links.map((link) => (
						<a class="button secondary" href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label} ↗
						</a>
					))}
				</div>
			</section>
		)}

		<section class="case-invitation" aria-labelledby="invitation-heading">
			<div>
				<h2 id="invitation-heading">Building something similar?</h2>
				<p>Tell me about the product or workflow your business needs.</p>
			</div>
			<a class="button" href={`/contact?project=${encodeURIComponent(project.name)}`}>
				Discuss your project ↗
			</a>
		</section>

		{related.length > 0 && (
			<section class="case-section related-work" aria-labelledby="related-heading">
				<h2 id="related-heading">More {story.category.toLowerCase()} work</h2>
				<div class="related-grid">
					{related.map((item) => (
						<a href={`/portfolio/${item.id}`}>
							<h3>{item.name} →</h3>
							<p>{item.pitch}</p>
						</a>
					))}
				</div>
			</section>
		)}
	</div>

	{imageUrls.length > 0 && (
		<dialog class="image-dialog" aria-labelledby="image-caption">
			<button class="dialog-close" type="button" aria-label="Close image">
				×
			</button>
			<figure>
				<img class="dialog-image" alt="" />
				<figcaption id="image-caption"></figcaption>
			</figure>
		</dialog>
	)}
</SiteLayout>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.image-dialog');
	const image = dialog?.querySelector<HTMLImageElement>('.dialog-image');
	const caption = document.getElementById('image-caption');
	let previousOverflow = '';

	document.querySelectorAll<HTMLButtonElement>('.screenshot-trigger').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (!dialog || !image || !caption) return;
			image.src = trigger.dataset.src ?? '';
			image.alt = trigger.dataset.caption ?? '';
			caption.textContent = image.alt;
			previousOverflow = document.body.style.overflow;
			dialog.showModal();
			document.body.style.overflow = 'hidden';
		});
	});

	dialog?.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target !== dialog) return;
		const bounds = dialog.getBoundingClientRect();
		if (
			event.clientX < bounds.left ||
			event.clientX > bounds.right ||
			event.clientY < bounds.top ||
			event.clientY > bounds.bottom
		)
			dialog.close();
	});
	dialog?.addEventListener('close', () => {
		document.body.style.overflow = previousOverflow;
	});
</script>

<style>
	.case-header {
		padding: 3rem 0 2.5rem;
		border-bottom: 1px solid rgba(47, 153, 131, 0.2);
	}
	.case-category {
		margin: 2rem 0 0;
	}
	.case-header h1 {
		margin-top: 0.75rem;
	}
	.case-header .lead {
		max-width: 850px;
	}
	.case-facts {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
		margin: 2.5rem 0 0;
	}
	.case-facts dt {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-teal);
		margin-bottom: 0.5rem;
	}
	.case-facts dd {
		margin: 0;
		font-size: 0.9rem;
	}
	.case-body {
		padding-top: 3rem;
		padding-bottom: 3rem;
	}
	.case-body h2 {
		font-size: clamp(1.3rem, 2.5vw, 1.75rem);
		margin: 0 0 1rem;
	}
	.case-body p {
		color: var(--color-text-light);
	}
	.case-overview {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}
	.case-overview p {
		margin-bottom: 0;
	}
	.case-section {
		margin-bottom: 3rem;
	}
	.case-copy {
		max-width: 850px;
	}
	.capabilities {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
		gap: 1rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
	}
	.capabilities li {
		padding: 1rem 1.25rem;
		background: rgba(47, 153, 131, 0.08);
		border-left: 3px solid var(--color-teal);
		border-radius: 0 8px 8px 0;
		font-size: 0.9rem;
	}
	.screenshot-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}
	.single-preview {
		grid-template-columns: 1fr;
		max-width: 850px;
		margin: auto;
	}
	figure {
		margin: 0;
		min-width: 0;
	}
	.screenshot-trigger {
		display: block;
		width: 100%;
		position: relative;
		border: 1px solid rgba(47, 153, 131, 0.2);
		border-radius: 12px;
		overflow: hidden;
		padding: 1rem;
		background: rgba(47, 153, 131, 0.04);
		cursor: zoom-in;
	}
	.screenshot-trigger img {
		width: 100%;
		height: 340px;
		object-fit: contain;
	}
	.expand-label {
		position: absolute;
		bottom: 0.75rem;
		right: 0.75rem;
		font-size: 0.7rem;
		background: var(--color-navy);
		color: var(--color-white);
		padding: 0.4rem 0.7rem;
		border-radius: 6px;
	}
	figcaption {
		margin-top: 0.75rem;
		font-size: 0.8rem;
		color: var(--color-text-light);
	}
	.case-outcome {
		border: 1px solid rgba(166, 143, 200, 0.4);
		border-left: 4px solid var(--color-lavender);
		border-radius: 8px;
		background: rgba(166, 143, 200, 0.08);
		padding: 2rem;
		margin-bottom: 3rem;
	}
	.case-outcome .eyebrow {
		display: block;
		margin-bottom: 0.75rem;
	}
	.case-outcome p:last-child {
		margin-bottom: 0;
	}
	.availability-note {
		font-size: 0.85rem;
	}
	.case-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.case-links .button {
		font-size: 0.9rem;
		border-color: rgba(47, 153, 131, 0.4);
	}
	.case-invitation {
		background: var(--color-navy);
		color: var(--color-white);
		padding: 2rem;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 3rem;
	}
	.case-invitation p {
		color: var(--color-white);
		margin-bottom: 0;
	}
	.case-invitation .button {
		flex-shrink: 0;
		color: var(--color-white);
	}
	.related-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}
	.related-grid a {
		text-decoration: none;
		border-top: 1px solid rgba(47, 153, 131, 0.3);
		padding: 1rem 0;
	}
	.related-grid h3 {
		font-size: 1.1rem;
	}
	.related-grid p {
		font-size: 0.9rem;
		margin-bottom: 0;
	}
	.image-dialog {
		position: fixed;
		max-width: 95vw;
		max-height: 94vh;
		padding: 3rem 1rem 1rem;
		border: 1px solid rgba(47, 153, 131, 0.3);
		border-radius: 12px;
		background: var(--color-white);
		color: var(--color-navy);
	}
	.image-dialog::backdrop {
		background: rgba(27, 57, 86, 0.9);
	}
	.dialog-image {
		max-height: 75vh;
		max-width: 85vw;
		object-fit: contain;
	}
	.dialog-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		border: 0;
		background: transparent;
		color: var(--color-navy);
		font-size: 2rem;
		cursor: pointer;
		line-height: 1;
		padding: 0.25rem 0.5rem;
	}
	@media (max-width: 768px) {
		.case-facts {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
		.case-facts > div:first-child {
			grid-column: 1 / -1;
		}
		.case-overview,
		.screenshot-grid,
		.related-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.case-invitation {
			flex-direction: column;
			align-items: flex-start;
		}
		.screenshot-trigger img {
			height: 280px;
		}
	}
	@media (max-width: 480px) {
		.case-outcome,
		.case-invitation {
			padding: 1.5rem;
		}
		.case-invitation .button {
			width: 100%;
			padding: 1rem;
		}
	}
</style>
