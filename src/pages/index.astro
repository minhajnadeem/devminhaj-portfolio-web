---
import EngagementFAQ from '../components/EngagementFAQ.astro';
import { contactDetails } from '../data/contact';
import SiteLayout from '../layouts/SiteLayout.astro';
import SDriveVisual from '../components/SDriveVisual.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import SelectedWork from '../components/SelectedWork.astro';
import ProjectInvitation from '../components/ProjectInvitation.astro';
---
<SiteLayout title="Apps & business platforms for founders" description="Independent product engineer building customer apps, operational dashboards, and connected backends for founders and service businesses. Explore delivered work and discuss your project."><section class="section hero"><div class="container split"><div><span class="eyebrow">Independent thinking. Complete delivery.</span><h1>From your idea.<br/>To a business<br/><em>that runs.</em></h1><p class="lead">The apps, website, and systems your business needs to launch and run.</p><p class="hero-intro">I’m Minhaj, an independent product engineer. I help founders and service businesses build customer apps, operational dashboards, and the backend that connects them—from planning through deployment.</p><div class="actions"><a class="button" href="/contact">Discuss your project ↗</a><a class="button secondary" href="/portfolio">View my work →</a></div><p class="hero-note">8+ years in mobile engineering · One accountable delivery partner</p><p class="hero-response">{contactDetails.response}</p></div><ProfilePhoto priority /></div></section><section class="early-trust" aria-label="Professional recommendation"><div class="container"><blockquote class="quote">“Whether delivering as a solo developer or contributing to a team, he consistently produces exceptional results. He is my go-to person for any mobile product.”</blockquote><p class="muted">Yahya K. · Mobile development recommendation</p><a class="text-link" href="https://www.linkedin.com/in/minhaj-nadeem/details/recommendations/" target="_blank" rel="noopener noreferrer">Read LinkedIn recommendations ↗</a></div></section>
<section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">Built around your business</span><h2>Where are you starting?</h2><p class="lead">For marketplaces, booking services, transport, delivery, and education—good software starts with how your business works.</p></div><div class="grid"><article class="card"><span class="number">01 / AN IDEA</span><h3>You’re ready to launch.</h3><p>Turn the product in your head into a practical first release, with a clear scope and a connected build.</p></article><article class="card"><span class="number">02 / A BUSINESS</span><h3>Your operations need to connect.</h3><p>Give customers and your team the tools to book, manage, and deliver your service in one connected system.</p></article><article class="card"><span class="number">03 / AN EXISTING PRODUCT</span><h3>You’re ready for what’s next.</h3><p>Add capabilities, improve your mobile experience, or extend the software your business already relies on.</p></article></div></div></section>
<section class="section services-section"><div class="container split"><div><span class="eyebrow">How I can help</span><h2>Connected decisions.<br/>Clear responsibility.</h2><p class="lead">Direct communication with the person building your software. Connected decisions across your product and operations.</p><a class="text-link" href="/services">Explore services →</a></div><div class="service-list"><article><span>01</span><div><h3>Launch a new product</h3><p>Planning, first-release scope, apps or web, backend, admin tools, and deployment.</p></div></article><article><span>02</span><div><h3>Build your business platform</h3><p>Customer and provider experiences connected to your team’s workflows.</p></div></article><article><span>03</span><div><h3>Improve an existing product</h3><p>New features, mobile development, integrations, and maintenance.</p></div></article></div></div></section>
<section class="section dark"><div class="container split"><div><span class="eyebrow">Flagship case study / SDrive</span><h2>A ride-hailing business.<br/>A connected platform.</h2><p class="lead">Riders, drivers, and administrators need different tools that work together. I independently delivered the rider and driver apps, marketing website, administration portal, backend, and cloud deployment.</p><div class="scope-tags"><span>Rider + driver apps</span><span>Website + admin</span><span>Backend + cloud</span></div><div class="actions"><a class="button" href="/portfolio/sdrive">Explore the SDrive story →</a></div></div><SDriveVisual compact /></div></section>
<section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">Selected work</span><h2>Different businesses.<br/>Real product experience.</h2><p class="lead">A multi-role education product, a marketplace, and an operational tool—each with a clearly defined delivery scope.</p></div><SelectedWork /><div class="actions"><a class="text-link" href="/portfolio">View all work →</a></div></div></section>
<section class="section process-section"><div class="container"><div class="section-heading"><span class="eyebrow">Working together</span><h2>A clear path from plan to launch.</h2></div><div class="process"><article><span class="eyebrow">01 / Understand</span><h3>Start with the business.</h3><p>Clarify users, workflows, and the problem the product needs to solve.</p></article><article><span class="eyebrow">02 / Plan</span><h3>Agree on the first release.</h3><p>Define scope, dependencies, milestones, and an estimate.</p></article><article><span class="eyebrow">03 / Build</span><h3>Review real progress.</h3><p>Build through reviewable milestones and demonstrate the connected experience.</p></article><article><span class="eyebrow">04 / Launch</span><h3>Prepare for real use.</h3><p>Test the system, deploy, and agree on handover and ongoing support.</p></article></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">Experience behind the delivery</span><h2>Technical depth.<br/>Personal accountability.</h2><p class="lead">My foundation is eight-plus years building Android and Flutter products, working with startups and remote teams across Dubai and Germany.</p><a class="text-link" href="/about">Get to know me →</a></div></div></section><EngagementFAQ compact /><ProjectInvitation /></SiteLayout>
<style>.hero{padding:70px 0 74px}.hero h1 em{font-style:normal;color:#2f9983}.hero-intro{max-width:580px;color:#6b7280;font-size:.98rem}.hero-note{font-size:.75rem;color:#6b7280;margin-top:24px;margin-bottom:0}.services-section,.process-section{background:#f7f0f0}.service-list article{display:flex;gap:24px;border-top:1px solid #2f998333;padding:22px 0}.service-list article>span{font-size:.8rem;color:#2f9983;padding-top:16px}.service-list p{color:#6b7280;margin:0}.scope-tags{display:flex;flex-wrap:wrap;gap:10px}.scope-tags span{border:1px solid #587c74;border-radius:4px;font-size:.75rem;padding:6px 10px}

.hero-response{font-size:.8rem;color:var(--color-navy);margin:8px 0 0}.early-trust{padding:32px 0;border-top:1px solid rgba(47,153,131,.2);border-bottom:1px solid rgba(47,153,131,.2);background:rgba(166,143,200,.06)}.early-trust .quote{max-width:900px;font-size:1.05rem;margin-bottom:16px}.early-trust .muted{font-size:.85rem;margin-bottom:12px}.early-trust .text-link{font-size:.85rem}
</style>
