---
import SiteLayout from '../layouts/SiteLayout.astro';
import { socialLinks } from '../data/social';
---

<SiteLayout title="Discuss your project">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Start a conversation</span>
      <h1>What does your<br />business need next?</h1>
      <p class="lead">Tell me what you want to launch or improve. You don’t need a technical specification to start.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>Let’s start with<br />the problem.</h2>
        <p class="muted">Get in touch through email, WhatsApp, or Upwork. Share a little about your business, what you want to build, and your preferred timeline.</p>
        <h3>What happens next?</h3>
        <p class="muted">I’ll review your enquiry and follow up to arrange a discussion if the project fits. We’ll clarify the scope and decide on a useful next step.</p>
      </div>
      <div class="contact-channels" aria-label="Ways to get in touch">
        <article class="card">
          <h3>Email me directly</h3>
          <p>For project enquiries and proposals.</p>
          <a class="text-link" href="mailto:minhaj.lib@gmail.com">minhaj.lib@gmail.com ↗</a>
        </article>
        <article class="card">
          <h3>Talk on WhatsApp</h3>
          <p>Start a conversation about your idea or existing product.</p>
          <a class="text-link" href="https://wa.me/923346241289" target="_blank" rel="noopener noreferrer">+92 334 6241289 ↗</a>
        </article>
        <article class="card">
          <h3>Prefer Upwork?</h3>
          <p>Discuss and manage your engagement through Upwork.</p>
          <a class="text-link" href={socialLinks.upwork} target="_blank" rel="noopener noreferrer">View my Upwork profile ↗</a>
        </article>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: start; }
  .contact-channels { display: grid; gap: 24px; min-width: 0; }
  .contact-channels h3 { margin-top: 0; }
  .contact-channels .text-link { overflow-wrap: anywhere; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 40px; } }
</style>
