---
interface Props {
	priority?: boolean;
}
const { priority = false } = Astro.props;
---

<div class="profile-frame">
	<img
		src="/assets/profile_img.jpg"
		alt="Muhammad Minhaj Nadeem, Full Stack Product Engineer"
		width="600"
		height="600"
		fetchpriority={priority ? 'high' : 'auto'}
		loading={priority ? 'eager' : 'lazy'}
		decoding="async"
	/>
</div>
<style>
	.profile-frame {
		position: relative;
		align-self: center;
		width: 100%;
		max-width: 450px;
		aspect-ratio: 1;
		justify-self: center;
		border: 8px solid var(--color-white);
		border-radius: 50%;
		overflow: hidden;
		background: linear-gradient(135deg, var(--color-teal), var(--color-navy));
		box-shadow: 0 10px 40px rgba(27, 57, 86, 0.2);
	}
	.profile-frame img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}
	@media (max-width: 900px) {
		.profile-frame {
			max-width: 360px;
		}
	}
	@media (max-width: 600px) {
		.profile-frame {
			max-width: 280px;
		}
	}
</style>
