---
import { portfolioProjects, getProjectImages } from '../data/portfolio';
import { standardCaseStudies } from '../data/caseStudies';
// The flagship is presented separately; show the next three projects in priority order.
const projects = portfolioProjects.filter((project) => project.caseStudyKind !== 'featured').slice(0, 3);
---
<div class="grid">
  {projects.map((project) => (
    <article class="project-card">
      <a href={`/portfolio/${project.id}`}>
        <div class="project-image">
          {getProjectImages(project)[0]
            ? <img src={getProjectImages(project)[0]} alt={`${project.name} application preview`} loading="lazy" />
            : <span>{project.name}</span>}
        </div>
        <h3>{project.name} ↗</h3>
      </a>
      <p>{project.description}</p>
      <p><strong>My responsibility:</strong> {standardCaseStudies[project.id].scope}.</p>
    </article>
  ))}
</div>
