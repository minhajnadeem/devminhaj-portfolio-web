---
import { engagementFaq } from '../data/faq';
interface Props {
	compact?: boolean;
}
const { compact = false } = Astro.props;
const questions = engagementFaq;
---

<section class="section engagement-faq" aria-labelledby="engagement-heading">
	<div class="container">
		<div class="section-heading">
			<span class="eyebrow">Before we start</span>
			<h2 id="engagement-heading">
				Clear expectations.
				<br />A defined technical scope.
			</h2>
			<p class="lead">
				Understand the implementation process, delivery scope, and handover before the work begins.
			</p>
		</div>
		<div class="faq-list">
			{questions.slice(0, compact ? 4 : undefined).map(({ question, answer }) => (
				<details>
					<summary>{question}</summary>
					<p>{answer}</p>
				</details>
			))}
		</div>
		{compact && (
			<p class="faq-more">
				<a class="text-link" href="/services#engagement-heading">
					Ownership, changes, costs, and support →
				</a>
			</p>
		)}
	</div>
</section>
<style>
	.engagement-faq {
		padding-top: 64px;
	}
	.faq-list {
		max-width: 900px;
	}
	.faq-more {
		margin: 24px 0 0;
	}
	summary {
		color: var(--color-navy);
	}
</style>
