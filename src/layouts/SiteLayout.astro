---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToBottom from '../components/ScrollToBottom.astro';
import { socialLinks } from '../data/social';
import { contactDetails } from '../data/contact';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import '../styles/global.css';
interface Breadcrumb {
	name: string;
	path: string;
}
interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	/** Path (or absolute URL) of a 1200x630 share image. Defaults to the site-wide image. */
	image?: string;
	imageAlt?: string;
	ogType?: 'website' | 'article' | 'profile';
	/** Extra JSON-LD nodes for this page (added to the shared @graph). */
	schema?: Record<string, unknown>[];
	/** Breadcrumb trail after "Home"; emits BreadcrumbList JSON-LD. */
	breadcrumbs?: Breadcrumb[];
}
const {
	title,
	noindex = false,
	description = 'Full Stack Product Engineer building mobile apps, websites, admin panels, backend systems, and cloud deployment for businesses.',
	image: imagePath = '/assets/og-image.png',
	imageAlt = 'Minhaj Nadeem, Full Stack Product Engineer',
	ogType = 'website',
	schema = [],
	breadcrumbs = [],
} = Astro.props;
const pageTitle = `${title} — Minhaj Nadeem`;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const image = new URL(imagePath, Astro.site);
const siteUrl = Astro.site!.href;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const abs = (path: string) => new URL(path, Astro.site).href;

const person = {
	'@type': 'Person',
	'@id': personId,
	name: 'Muhammad Minhaj Nadeem',
	alternateName: 'Minhaj Nadeem',
	jobTitle: 'Full Stack Product Engineer',
	description:
		'Full Stack Product Engineer with eight-plus years in Android and Flutter, delivering connected mobile, web, backend, and cloud platforms.',
	url: siteUrl,
	image: abs('/assets/profile_img.png'),
	email: `mailto:${contactDetails.email}`,
	knowsAbout: [
		'Flutter',
		'Android development',
		'Kotlin',
		'Dart',
		'Full stack development',
		'Backend systems',
		'Google Cloud',
		'Firebase',
		'Admin dashboards',
		'Technical consulting',
	],
	sameAs: Object.values(socialLinks),
};
const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: siteUrl,
	name: 'Minhaj Nadeem',
	inLanguage: 'en',
	publisher: { '@id': personId },
};
const breadcrumbList = breadcrumbs.length
	? {
			'@type': 'BreadcrumbList',
			itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((item, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: item.name,
				item: abs(item.path),
			})),
		}
	: null;
const graph = {
	'@context': 'https://schema.org',
	'@graph': [person, website, ...(breadcrumbList ? [breadcrumbList] : []), ...schema],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1b3956" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		<title>{pageTitle}</title>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Minhaj Nadeem" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<ScrollToBottom />
		<script>
			import '../scripts/lead-intent';
		</script>
	</body>
</html>
