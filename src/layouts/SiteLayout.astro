---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingFollowBar from '../components/FloatingFollowBar.astro';
import ScrollToBottom from '../components/ScrollToBottom.astro';
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Minhaj is an independent product engineer building connected apps, websites, admin systems, backends, and cloud deployments for founders and businesses.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="icon" href="/favicon.jpg" /><title>{title} — Minhaj Nadeem</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" /></head><body><a class="skip-link" href="#main">Skip to content</a><FloatingFollowBar /><Header /><main id="main"><slot /></main><Footer /><ScrollToBottom /></body></html>
